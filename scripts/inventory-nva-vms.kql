// =============================================================================
// Azure Resource Graph -- MANA / NVA readiness inventory (Virtual Machines)
// =============================================================================
// Purpose: find and classify candidate NVA / Accelerated-Networking (AN) workloads at
// scale, with enough vendor / image / OS introspection to decide the LegacyVMNVA action.
//
// One row PER VM (multi-NIC safe): NICs are summarized per VM before the join, so a
// multi-NIC VM produces exactly ONE row and mixed AN is surfaced as "Partial (n/m)".
//
// Columns:
//   Vendor        -- best-effort vendor: Marketplace PLAN publisher first, else image publisher.
//   PlanPublisher -- Azure Marketplace plan publisher. THIS is what the built-in LegacyVMNVA
//                    policy matches on (not imageReference.publisher). Empty => not a paid/BYOL
//                    Marketplace image.
//   PlanProduct   -- Marketplace plan product/offer id.
//   NVAVendor     -- "Yes (policy-scoped)" if Vendor is in the built-in policy's publisher
//                    allow-list (below) => the policy CAN auto-tag it. "No / unknown" otherwise.
//   ImageSource   -- Marketplace | Gallery/Custom | Platform | Custom/VHD. Determines whether the
//                    built-in policy can auto-tag (only Marketplace publishers in scope are tagged).
//   OSType        -- Linux / Windows -> tells you .sh (RunShellScript) vs .ps1 (RunPowerShellScript).
//   OSVersion     -- image offer / sku (distro + version, e.g. "ubuntu-24_04-lts / server").
//   AcceleratedNetworking -- per-NIC accurate: Enabled / Disabled / Partial (n/m) / No NIC found.
//   LegacyVMNVATag-- tag value or "Not set" (presence only; enabling still needs a reapply).
//   Assessment    -- control-plane triage verdict (see logic below). ALWAYS confirm on-host.
//
// Runs in Azure Resource Graph Explorer (portal) or via CLI:
//   az graph query -q "@scripts/inventory-nva-vms.kql" --first 1000 \
//     --query "data[].{Sub:subscriptionId,RG:resourceGroup,VM:VMName,Vendor:Vendor,NVA:NVAVendor,ImageSource:ImageSource,OS:OSType,OSVersion:OSVersion,Size:VMSize,AN:AcceleratedNetworking,Tag:LegacyVMNVATag,Verdict:Assessment}" -o table
//   (CLI needs: az extension add -n resource-graph)
//
// Scope: standalone VMs and VMSS Flex member instances. For VMSS Uniform, also run inventory-nva-vmss.kql.
// ARG CAN see: publisher/plan, size, OS, per-NIC AN flag, resource tags.
// ARG CANNOT see: whether the VM is actually on MANA hardware (verify in-guest with detect-mana.sh /
//   validate-nva-mana.*), nor whether a present LegacyVMNVA tag has been ENABLED via a reapply.
// NVA classification is a HELP signal only -- appliance vendors deploy via many image types;
//   always confirm with the vendor's MANA-compatibility matrix.
// =============================================================================

Resources
| where type =~ 'microsoft.compute/virtualmachines'
| extend img = properties.storageProfile.imageReference   // plan is a TOP-LEVEL resource property (not under properties)
| extend
    ImgPublisher   = tostring(img.publisher),
    Offer          = tostring(img.offer),
    Sku            = tostring(img.sku),
    ImgVersion     = tostring(img.version),
    GalleryImageId = tostring(img.id),
    PlanPublisher  = tostring(plan.publisher),
    PlanProduct    = tostring(plan.product),
    PlanName       = tostring(plan.name),
    OSType         = tostring(properties.storageProfile.osDisk.osType),
    LegacyVMNVATag = iff(isnotempty(tostring(tags['LegacyVMNVA'])), tostring(tags['LegacyVMNVA']), "Not set")
// Vendor: prefer the Marketplace PLAN publisher (what the LegacyVMNVA policy matches); else image publisher.
| extend Vendor = iff(isnotempty(PlanPublisher), PlanPublisher, iff(isnotempty(ImgPublisher), ImgPublisher, "unknown/custom"))
// OSVersion: the image offer/sku carries the distro/version.
| extend OSVersion = iff(isnotempty(Sku), strcat(Offer, " / ", Sku), "custom image (no publisher/sku)")
// ImageSource: how the VM was created -> whether the built-in policy can auto-tag it.
| extend ImageSource = case(
    isnotempty(PlanName), "Marketplace",
    isnotempty(GalleryImageId), "Gallery/Custom",
    isnotempty(ImgPublisher), "Platform",
    "Custom/VHD")
// Known NVA publishers = snapshot of the built-in LegacyVMNVA policy default publisher allow-list.
// The policy ONLY auto-applies the tag to these Marketplace publishers. Re-verify against the live
// policy definition (e87a87f5-e6dd-4919-be21-abb0a4ea4630) for the complete/current set.
| extend _nvaPublishers = dynamic([
    'arista-networks','avi-networks','aviatrix-systems','barracudanetworks','bluecat','checkpoint',
    'cisco','citrix','cohesive','f5-networks','fortinet','haproxy-technologies','heimdall-data',
    'hillstone-networks','imperva','ivanti-vadc','juniper-networks','kemptech','netapp','netgate',
    'netskope','nttltd','paloaltonetworks','pulse-secure','radware','riverbed','silver-peak-systems',
    'sonicwall-inc','sophos','trendmicro','twistlock','velocloud','versanetworks','vmware-inc',
    'watchguard-technologies'])
| extend _vendorLower = tolower(Vendor)
| extend NVAVendor = iff(
    set_has_element(_nvaPublishers, _vendorLower) or _vendorLower startswith 'a10networks' or _vendorLower startswith 'zscaler',
    "Yes (policy-scoped)", "No / unknown")
| project vmId = tolower(id), VMName = name, VMSize = tostring(properties.hardwareProfile.vmSize),
    Vendor, PlanPublisher, PlanProduct, NVAVendor, ImageSource, OSType, OSVersion, Offer, Sku, ImgVersion,
    LegacyVMNVATag, resourceGroup, subscriptionId, location
| join kind=leftouter (
    Resources
    | where type =~ 'microsoft.network/networkinterfaces'
    | where isnotempty(properties.virtualMachine.id)
    | project vmId = tolower(tostring(properties.virtualMachine.id)),
        AN = iff(properties.enableAcceleratedNetworking == true, 1, 0)
    // one row per VM: total NICs and how many have Accelerated Networking
    | summarize NICCount = count(), ANEnabledNICs = sum(AN) by vmId
) on vmId
| extend NICCount = coalesce(NICCount, 0), ANEnabledNICs = coalesce(ANEnabledNICs, 0)
| extend AcceleratedNetworking = case(
    NICCount == 0, "No NIC found",
    ANEnabledNICs == 0, "Disabled",
    ANEnabledNICs == NICCount, "Enabled",
    strcat("Partial (", tostring(ANEnabledNICs), "/", tostring(NICCount), ")"))
// Triage verdict -- control-plane signal only; always confirm on-host before acting.
// The LegacyVMNVA tag is ONLY for AN-based NVAs; general workloads need no action even on MANA.
| extend Assessment = case(
    NICCount == 0, "Review - no NIC data",
    ANEnabledNICs == 0, "No action - AN disabled",
    LegacyVMNVATag != "Not set", "Opt-out tag present - confirm reapply, then plan migration",
    NVAVendor startswith "Yes", "NVA (policy-scoped vendor) - validate on host; tag if not MANA-ready",
    ImageSource in ("Marketplace","Gallery/Custom","Custom/VHD"), "AN non-platform image - verify on host; if it is an NVA not in policy scope, tag manually",
    "AN general VM - verify on host (likely no action)")
| project
    subscriptionId,
    resourceGroup,
    VMName,
    Vendor,
    PlanPublisher,
    PlanProduct,
    NVAVendor,
    ImageSource,
    OSType,
    OSVersion,
    VMSize,
    NICCount,
    AcceleratedNetworking,
    LegacyVMNVATag,
    Assessment,
    location
| order by Assessment asc, Vendor asc, VMName asc
